{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/handler.cjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/@napi-rs/canvas/**",
          "node_modules/@napi-rs/canvas-linux-x64-gnu/**",
          "node_modules/pdf-parse/**",
          "node_modules/pdfjs-dist/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/handler.cjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)\\.(?:js|mjs|css|map|json|png|jpe?g|gif|svg|ico|webp|woff2?|ttf)$",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}